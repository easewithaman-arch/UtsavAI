# UtsavAI environment configuration (server-side only).
# Copy this file to `.env` and fill in the values you need.
# Without an API key the app runs in demo mode using built-in planning rules.

# API key for your AI provider. AI_API_KEY or OPENAI_API_KEY is accepted.
AI_API_KEY=
# OPENAI_API_KEY=

# Base URL of an OpenAI-compatible chat completions endpoint.
# Defaults to https://api.openai.com/v1 when unset.
AI_BASE_URL=https://api.openai.com/v1

# Model name to request. Defaults to gpt-4o-mini when unset.
AI_MODEL=gpt-4o-mini

# Port for the API/static server (npm start). The Vite dev proxy expects 8787.
PORT=8787
